# .env.local — optional local credentials for opencode-dispatch.
# Copy this file to `.env.local` and fill in the values. Credentials are keyed
# by the address the dispatcher actually uses: the profile fields and the
# address-keyed map in servers.json are the normal multi-server store. The
# single values below are only the fallback for profiles without their own
# credential. Without any of them, the defaults apply (username `opencode`,
# no password).
#
# Rules:
#   - Only the variables below are read; anything else is ignored.
#     OPENCODE_PASSWORD is accepted as the v2 name for the same password slot.
#   - OPENCODE_SERVER_CREDENTIALS is a JSON object keyed by host, host:port, or
#     a full URL; a value is a password string or {username, password}. It
#     overrides servers.json and the per-profile fields.
#   - Values apply ONLY when the credential is not already set in your
#     environment (an exported shell var always wins over this file, under
#     either password name).
#   - This file is gitignored; keep it out of version control.

OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=REPLACE_ME
# OPENCODE_PASSWORD=REPLACE_ME
# OPENCODE_SERVER_CREDENTIALS={"127.0.0.1:4096":{"password":"REPLACE_ME"},"192.0.2.50":"REPLACE_ME"}
