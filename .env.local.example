# .env.local — optional local credentials for opencode-dispatch.
# Copy this file to `.env.local` and fill in the values. When it exists, every
# dispatch mode (serve, task, ask, sessions, ...) launches servers with these
# credentials and authenticates all requests with them; without it, the
# defaults apply (username `opencode`, password from the server profile or
# OPENCODE_SERVER_PASSWORD).
#
# Rules:
#   - Only the two variables below are read; anything else is ignored.
#   - Values apply ONLY when the variable is not already set in your
#     environment (an exported shell var always wins over this file).
#   - This file is gitignored; keep it out of version control.

OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=REPLACE_ME
